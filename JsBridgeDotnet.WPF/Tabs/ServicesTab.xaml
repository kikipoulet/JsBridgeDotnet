<UserControl x:Class="JsBridgeDotnet.WPF.Tabs.ServicesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JsBridgeDotnet.WPF.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Template pour les nœuds de service (niveau racine) -->
        <HierarchicalDataTemplate DataType="{x:Type local:ServiceNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,3,5,3">
                <TextBlock Text="{Binding ServiceName}" 
                          FontWeight="Bold" 
                          FontSize="13"/>
                <TextBlock Text="{Binding ServiceType}" 
                          FontSize="11" 
                          Foreground="Gray"
                          Margin="0,2,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template pour les catégories (Methods, Properties, Events) -->
        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,3,5,3">
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Icon}"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template pour les méthodes -->
        <HierarchicalDataTemplate DataType="{x:Type local:MethodNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,2,5,2" Orientation="Horizontal">
                <TextBlock Text="🔹 " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" 
                          FontSize="11" 
                          Foreground="#333333"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template pour les propriétés -->
        <HierarchicalDataTemplate DataType="{x:Type local:PropertyNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,2,5,2">
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#333333"/>
                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="Gray" Margin="5,0,0,0"/>
                <!-- Afficher la valeur actuelle -->
                <TextBlock Text="{Binding DisplayName}" 
                          FontSize="10" 
                          Foreground="#0066c4"
                          Margin="15,0,0,0"
                          FontStyle="Italic"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template pour les paramètres -->
        <HierarchicalDataTemplate DataType="{x:Type local:ParameterNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,2,5,2" Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" 
                          FontSize="10" 
                          Foreground="#666666"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template pour les événements -->
        <HierarchicalDataTemplate DataType="{x:Type local:EventNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="5,2,5,2" Orientation="Horizontal">
                <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" 
                          FontSize="11" 
                          Foreground="#333333"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <TreeView x:Name="servicesTreeView" 
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="False"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
