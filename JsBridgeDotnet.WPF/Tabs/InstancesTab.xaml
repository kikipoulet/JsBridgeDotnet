<UserControl x:Class="JsBridgeDotnet.WPF.Tabs.InstancesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JsBridgeDotnet.WPF.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DataGrid x:Name="instancesDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal">
            
            <DataGrid.Columns>
                <!-- Service Name -->
                <DataGridTextColumn Header="Service Name" 
                                  Width="*"
                                  Binding="{Binding ServiceName}"
                                  FontSize="11"/>
                
                <!-- Service Type -->
                <DataGridTextColumn Header="Type" 
                                  Width="*"
                                  Binding="{Binding ServiceType}"
                                  FontSize="11"/>
                
                <!-- Instance ID -->
                <DataGridTextColumn Header="Instance ID" 
                                  Width="120"
                                  Binding="{Binding DisplayInstanceId}"
                                  FontSize="11"/>
                
                <!-- Lifetime -->
                <DataGridTextColumn Header="Lifetime" 
                                  Width="100"
                                  Binding="{Binding Lifetime}"
                                  FontSize="11"/>
                
                <!-- Status -->
                <DataGridTextColumn Header="Status" 
                                  Width="100"
                                  Binding="{Binding Status}"
                                  FontSize="11"/>
                
                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" 
                                    Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Kill"
                                    Width="60"
                                    Height="25"
                                    FontSize="11"
                                    Padding="5,2"
                                    Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
